# Get these from your Checkout.com sandbox Dashboard -> Developers -> API keys
# Secret key must have the "payment-sessions" scope. Never expose it client-side.
CHECKOUT_SECRET_KEY=sk_sbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public key must have "payment-sessions:pay" and "vault-tokenization" scopes.
# This one IS exposed to the browser (checkout.js), that's expected.
CHECKOUT_PUBLIC_KEY=pk_sbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sandbox API base (leave as-is unless Checkout.com gave you a different prefix)
CHECKOUT_API_PREFIX=https://api.sandbox.checkout.com

# Where this app is running, used for success/failure redirect URLs
PUBLIC_BASE_URL=http://localhost:4242

PORT=4242
